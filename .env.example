# Copy this file to .env.local for local development, and set the same
# names in Vercel -> Project -> Settings -> Environment Variables.
# Never put real values in this file. It is committed to GitHub.

# Supabase (public values, safe to expose to the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Social sign-in buttons to show. Add linkedin_oidc only after enabling it in Supabase.
VITE_AUTH_PROVIDERS=google

# NIPOST digital postcode API (server only, keep secret)
POSTCODE_API_BASE=
POSTCODE_API_KEY=

# Set to "true" only for testing, to switch off the free-check daily limit
DEMO_UNLIMITED=
